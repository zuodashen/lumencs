# 聊天（Java Spring AI）。OpenAI 兼容网关均可。
# 根地址不要带 /v1，Java 会自行补全。
# 令牌必须和站点配套：国际站 https://www.dmxapi.com（美金）/ 国内站 https://www.dmxapi.cn（人民币）。
# Global 控制台建的 Key 填 .com；填错站会 401「无效的令牌」。
OPENAI_API_KEY=sk-your-chat-key
OPENAI_BASE_URL=https://www.dmxapi.com
# 必须与该 Key 在网关里允许的模型一致。例如 DMX「模型限制」勾了 deepseek-v4-flash，这里就不能写 gpt-4o-mini。
MODEL_NAME=deepseek-v4-flash

# 向量化（仅 rag-service）。本机当前与聊天拆开：硅基流动 SiliconFlow。
# 根地址不要带 /v1，Python 会自行补全。
# 未填 EMBEDDING_API_KEY 时回退到 OPENAI_*（不要让向量误打到聊天网关）。
EMBEDDING_API_KEY=sk-your-embedding-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn
EMBEDDING_MODEL=BAAI/bge-m3
# 必须与模型维度一致：BAAI/bge-m3=1024，text-embedding-3-small=1536。改维度会重建 Qdrant collection，需在控制台「重新向量化」。
EMBEDDING_DIM=1024

# 管理后台初始账号（首次启动自动写入）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=lumen123

# JWT（双 token：access 短效 + refresh 长效）
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_HOURS=168

# 聊天限流（固定窗口：窗口内允许次数）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_WINDOW_SECONDS=60

# RAG 链路开关（改写/重排走 LLM，会消耗 Token，可关）
RAG_REWRITE_ENABLED=true
RAG_RERANK_ENABLED=true

# 工单 SLA（WAITING_HUMAN 超时提醒，演示可把分钟改小）
SLA_WAITING_HUMAN_MINUTES=120

# 博客定时同步 cron（默认每 6 小时）
BLOG_SYNC_CRON=0 0 */6 * * *


# 仅本地直连时使用；Docker Compose 内会覆盖为服务名
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=lumen_cs
MYSQL_USER=lumencs
MYSQL_PASSWORD=lumencs
MYSQL_ROOT_PASSWORD=lumencs_root

REDIS_HOST=localhost
REDIS_PORT=6379

QDRANT_URL=http://localhost:6333
BLOG_BASE_URL=http://8.155.149.208/lightdiary-api
# 博客公开站点，发布成功后拼 /post/{slug}
BLOG_PUBLIC_WEB_URL=http://8.155.149.208/lightdiary-web
# 聊天写博客：默认关。打开后访客仍不能写，需先登录中枢控制台（聊天请求带 Bearer）。
# 卡片一次性 confirmToken；账号用 LightDiary 后台管理员，不要填博客 MySQL 密码，也不要提交真实口令。
BLOG_WRITE_ENABLED=false
BLOG_ADMIN_USERNAME=
BLOG_ADMIN_PASSWORD=

