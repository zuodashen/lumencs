# LLM（OpenAI 兼容网关均可，例如官方 / 中转）
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.openai.com
# 中转网关填根地址，不要带 /v1。Java Spring AI 与 Python 会自行补全 /v1。
# 示例: https://api.b.ai
MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# 管理后台初始账号（首次启动自动写入）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=lumen123

# JWT（双 token：access 短效 + refresh 长效）
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_HOURS=168

# 聊天限流（固定窗口：窗口内允许次数）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_WINDOW_SECONDS=60

# RAG 链路开关（改写/重排走 LLM，会消耗 Token，可关）
RAG_REWRITE_ENABLED=true
RAG_RERANK_ENABLED=true

# 博客定时同步 cron（默认每 6 小时）
BLOG_SYNC_CRON=0 0 */6 * * *

# 仅本地直连时使用；Docker Compose 内会覆盖为服务名
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=lumen_cs
MYSQL_USER=lumencs
MYSQL_PASSWORD=lumencs
MYSQL_ROOT_PASSWORD=lumencs_root

REDIS_HOST=localhost
REDIS_PORT=6379

QDRANT_URL=http://localhost:6333
BLOG_BASE_URL=
# 博客公开 API 根，例如 http://localhost:8081/lightdiary-api ；空则跳过 L3 同步与 blog_search

